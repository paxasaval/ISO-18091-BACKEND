# Copiar a .env y completar. NO versionar el .env real.

# Conexión a MongoDB. Incluir el nombre de la BD en la que se restauró el paquete
# (ver entrega-bd/README.md), p. ej. mongodb://usuario:clave@servidor:27017/baldurwatch
MONGODB_URI=
# Solo para `npm test` (puede ser otra BD del mismo servidor)
TEST_MONGODB_URI=

PORT=3001

# Clave para firmar los JWT: cadena larga y aleatoria propia del despliegue.
# Al cambiarla, las sesiones abiertas dejan de ser válidas (no afecta a los datos).
SECRET=

# Roles (API v1). ROL_ADMIN_KEY es el _id del rol administrador en la colección
# `rols`: se conserva al restaurar, así que hay que mantener el MISMO valor.
ROL_ADMIN=
ROL_ADMIN_KEY=
ROL_REPONSIBLE=
ROL_USER=

# Opcional: orígenes CORS permitidos separados por coma (por defecto
# http://localhost:4200 y los dominios de despliegue actuales)
CORS_ORIGINS=
