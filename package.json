{
  "name": "backend",
  "version": "0.1.2",
  "description": "Backend plataforma ISO 18091",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --verbose --runInBand",
    "deploy": "git push",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "dev": "cross-env NODE_ENV=development tsx watch index.js",
    "dev-test": "cross-env NODE_ENV=test tsx watch index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:v2": "tsx src/v2/migration/migrate.ts"
  },
  "keywords": [
    "node",
    "express",
    "ISO-18091"
  ],
  "author": "paxasaval, pabloPicon",
  "license": "ISC",
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.3.5",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "mongoose-paginate-v2": "^1.7.1",
    "mongoose-unique-validator": "^4.0.0",
    "openapi-types": "^12.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.36.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
